// 3. TEST ESPRESSIONI E PRECEDENZE (Pratt Parser)
// Controlla l'associatività a destra dell'assegnamento e il ternario
int a = 0
int b = 0
int c = a = b = 42
bool logic = !true || (a++ * 2) >= --b << 2 ? true : false
int range_test = [1*87-7, 2, 3, 4][0..2]

// 4. TEST STRUTTURE DI CONTROLLO (Blocchi Uniformi)
if c > 0:
    int internal = 100
    while internal > 0:
        internal--
        if internal == 50:
            continue // Test Break/Continue
        elif internal == 10:
            continue
else:
    print("Lower than zero")

// 5. TEST FUNZIONI CON VALORI DI DEFAULT
// Verifica se il Printer ora mostra i valori di default (defaultValue)
