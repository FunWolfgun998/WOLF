void invalidVoid
void[] invalidVoidArr

// 3. E0008: Overflow intero a 32-bit
int overflow = 3000000000

// 4. E0002: Variabile usata prima dell'inizializzazione
int uninit
int readUninit = uninit + 5

// 5. E0013: Null assegnato a non-nullable
int notNullable = null
int assignTarget = 10
assignTarget = null

// 6. E0014: Dereferenziazione su nullable
class User:
    public:
    int id = 1

User? maybeUser = null
int userId = maybeUser.id

// 7. E0029: Accesso a membro protected
class Parent:
    protected:
    int secret = 42

class Unrelated:
    void test():
        Parent p = Parent()
        int val = p.secret

// 8. E0035: Ereditarietà ciclica
class NodeA extends NodeB:
    public:
    int a = 1

class NodeB extends NodeA:
    public:
    int b = 2