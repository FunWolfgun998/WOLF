// --- WOLF COMPREHENSIVE TEST SUITE ---

// 1. Variables and Literals
int id = 998
float pi = 3.14159
char letter = 'W'
string greeting = f"Hello, World! ID is {id}"

// 2. Arrays and Ranges
int[] numbers = [1, 2, 3, 4, 5]
int firstNum = numbers[0]
for i in 0..10:
    id++

// 3. Control Flow & Ternary
bool status = true
string message = status ? "Active" : "Inactive"

if (id == 998):
    int o = 10
elif (id == 89):
    string c = "c"
else:
    float z = 9.0
    z *= id

while (id >= 45):
    id--
    if (id == 50):
        break
    else:
        continue

// 4. Structs
struct Point:
    int x
    int y

// 5. Classes, Inheritance, Access Modifiers, and 'this' (C++ flat style)
class Animal:
    private:
    string species
    public:
    void setSpecies(string s):
        this.species = s

class Dog extends Animal:
    private:
    string name
    public:
    string getName():
        return this.name
    void bark():
        print("Woof!")

// 6. Functions with Default Parameters
int add(int a, int b = 10):
    return a + b

int result = add(5)