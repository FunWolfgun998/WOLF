// 2. Numeric Literals: Decimal, Hexadecimal, Binary, Octal, Floats, Scientific
int decNum = 42
int hexNum = 0xFF
int binNum = 0b101101
int octNum = 0o755
float standardFloat = 3.14159
float scientificFloat1 = 9.98e9
float scientificFloat2 = 1.25e-4

// 3. Character and String Literals: ASCII, Escape Sequences, Unicode, Raw, Format
char asciiChar = 'W'
char newlineChar = '\n'
char tabChar = '\t'
char unicodeChar = '€'
string standardStr = "Hello\tWorld!\n"
string rawPath = r"C:\Wolf\Compiler\bin\""
string formatStr = f"Value is: {decNum} with hex {hexNum}"

// 4. Variables, Constants, Arrays, and Nullable Type Combinations
const int MAX_BUFFER = 1024
const float GRAVITY = 9.81

int simpleInt = 10
int? nullableInt = null
int[] singleDimArray = [1, 2, 3, 4, 5]
int[][] matrix = [[1, 2], [3, 4]]
int[]? nullableArray = null
int?[] arrayOfNullables = [1, null, 3]
int[][]? nullableMatrix = null

// 5. Struct Declarations and Custom Type Instantiations
struct Point:
    int x
    int y

struct Rectangle:
    Point topLeft
    Point bottomRight

Point origin = Point()
origin.x = 0
origin.y = 0

Rectangle screenBounds = Rectangle()
screenBounds.topLeft = origin

// 6. Classes, Inheritance, Access Specifiers, 'this', and 'base'
class Entity:
    protected:
    int entityId
    public:
    void setId(int id):
        this.entityId = id
    int getId():
        return this.entityId

class Player extends Entity:
    private:
    string username
    int health
    public:
    void init(string name, int hp):
        this.username = name
        this.health = hp
        base.setId(1)
    string getUsername():
        return this.username
    int getHealth():
        return this.health
    void takeDamage(int amount):
        this.health -= amount
        if (this.health < 0):
            this.health = 0

Player hero = Player()
hero.init("WolfWarrior", 100)
hero.takeDamage(25)

// 7. Operators, Compound Assignments, and Pratt Precedence
int a = 10
int b = 20
int c = 30

// Precedence test: arithmetic and parenthesis grouping
int mathResult = a + b * c - (c / a) % 2

// Bitwise, shift, and logical operations
int bitwiseResult = (a & b) | (c ^ a)
int shiftResult = (a << 2) >> 1
bool logicResult = (a < b) && (b <= c) || !(a == c)

// Unary prefix and postfix operations
a++
++b
c--
--a
int negated = -a
bool inverted = !logicResult
int bitInverted = ~bitwiseResult

// Compound in-place assignment operators
a += 5
b -= 3
c *= 2
a /= 2
b %= 4
a &= 0xFF
b |= 0x01
c ^= 0x10
a <<= 1
b >>= 1

// 8. Type Casting ('as') and Type Checking ('is')
float castedFloat = a as float
int[]? castedArray = null as int[]?
bool checkType = hero is Player
bool checkBaseType = hero is Entity

// 9. Ternary Operator and Range Expressions
string statusText = (hero.getHealth() > 50) ? "Healthy" : "Critical"
string nestedTernary = (a > 10) ? "High" : (a > 5) ? "Medium" : "Low"

// Range operator evaluation
int[] rangeValues = 0..100

// 10. Control Flow: If, Elif, Else
if (a > b):
    int temp = a
    a = b
    b = temp
elif (a == b):
    a = 0
elif (b == c):
    b = 0
else:
    c = 0

// 11. Control Flow: While, For In, Break, Continue
int loopCounter = 10
while (loopCounter > 0):
    loopCounter--
    if (loopCounter == 5):
        continue
    if (loopCounter == 1):
        break

for i in 0..10:
    a += i

// 12. Functions: Parameters, Default Values, and Complex Return Types
int add(int x, int y = 10):
    return x + y

void logMessage(string msg):
    return

Point? findPoint(int id):
    if (id == 0):
        return origin
    return null

int addResult = add(15)
int explicitAddResult = add(15, 25)
Point? lookupResult = findPoint(0)