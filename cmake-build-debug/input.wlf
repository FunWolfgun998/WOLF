// Numeri, Basi e Scientifici
int ddd = 10.
int metgoh 0 10.methot()
int dec = 42
int hex = 0xFF
int bin = 0b1010
int oct = 0o77
float p = 3.14159
float sci = 7.98e67

// Edge Cases dei Punti (Dot Ambiguity)
int start = 1..10       // Range operator
int ten = 10.           // Int seguito da operatore punto
float half = .5         // Float senza zero iniziale

// Unicode e String Interning
string nome = "Wolf"
int _under_score = 100
string città = "Roma"   // Unicode support (\xC3\xA0)

// Stringhe Speciali e Caratteri
string path = r"C:\Users\Wolf"     // Raw string
string format = f"Val: {dec}"      // Format string
char nl = '\n'
char letter = 'A'

// Operatori a 1, 2 e 3 livelli
x++
x --
x <<= 2
bool check = (x >= 40) && (x != 0) || ~(x) ? 1 : 0
int arr =[1, 2, 3][0]

// Indentazione corretta (Python style)
if (dec > 0):
    int inner = 1
    if (inner == 1):
        print("OK")
    // Dedent a livello 1
    dec += 1
else:
    dec -= 1

