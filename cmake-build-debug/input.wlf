// ==========================================
// PARTE 1: SINTASSI VALIDA (Front-End Challenge)
// ==========================================

// 1. Numeri e Basi (Lexer Check)
int dec = 42
int hex = 0xFF
int bin = 0b1010
int oct = 0o77
float p = 3.14159
float sci = 7.98e10
float dot_start = .5
float dot_end = 10.

// 2. Ambiguità del Punto (Lexer + Parser)
int simple_dot = 10.method()
int range_dot = 1..10
float complex_dot = .5.toString()

// 3. Stringhe e Caratteri (Escapes & Types)
string normal = "Wolf Lang\nVersion 1.0"
string raw = r"C:\Users\Name\Desktop"
string fmt = f"Value is: {dec}"
char tab = '\t'
char unicode = 'Ω'

// 4. Espressioni Complesse (Pratt Parser Power)
// Questo controlla: Postfissi, Prefissi, Aritmetica, Logica, Ternario e Assegnamenti
bool logic = !true || (x++ * 2) >= --y << 2 && ~(a ^ b) ? true : false
int chaining = a = b = c = 50
int math = 1 + 2 * 3 / (4 - 5) % 6

// 5. Array (Literals & Access)
int list = [1, 2, 3, 4 + 5][0]
int matrix = [[1, 0], [0, 1]][1][1]

// 6. Strutture Controllo Flusso (Recursive Descent)
if dec > 0:
    int a = 1
    while a < 10:
        a++
        if a == 5:
            continue
        elif a == 8:
            break
elif dec < 0:
    return -1
else:
    print("Zero")

// 7. Funzioni e Parametri (Default Values)
void fast_func(int a, float b = 3.14, string msg = "Default"):
    for i in 0..a:
        print(msg)
    return

// 8. Structs (User Defined Types)
struct Player:
    string name
    int score = 0
    float health = 100.0

