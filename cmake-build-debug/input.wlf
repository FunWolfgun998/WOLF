class Node:
    public:
    int value = 42
    Node? next = null

// 1. SHORT-CIRCUIT IN CONDITION (user != null && user.value > 0)
void testShortCircuit(Node? n):
    if (n != null && n.value > 0):
        int val = n.value

// 2. WHILE LOOP SMART-CAST
void testWhileLoop(Node? head):
    while (head != null):
        int v = head.value
        head = head.next

// 3. TERNARY SMART-CAST
int testTernary(Node? n):
    return n != null ? n.value : 0

// 4. GUARD CLAUSE / EARLY EXIT
int testGuardClause(Node? n):
    if (n == null):
        return -1

    // n is guaranteed non-null here!
    return n.value

// 5. CONST IMMUTABILITY PRESERVATION IN SMART-CAST
void testConstSmartCast(Node? n):
    const Node? cNode = n
    if (cNode != null):
        // cNode is promoted to non-null, but MUST remain immutable (const)!
        cNode = null // Error E0003

// 6. FOR-LOOP NULLABLE ARRAY CHECK
void testNullableArrayIteration(int[]? nullableList):
    for item in nullableList: // Error E0015
        int x = item