// 1. ABSTRACT CLASS E METODI (E0036 ed E0037)
abstract class Shape:
    public:
    abstract int getArea()

// Tentativo illegale di istanziare classe astratta (E0036)
Shape s = Shape()

// Classe concreta che non implementa getArea() (E0037)
class IncompleteCircle extends Shape:
    public:
    int radius = 5

// 2. OVERRIDE VALIDATION (E0038)
class Square extends Shape:
    public:
    // Override valido
    override int getArea():
        return 16

    // Override non valido: firma non corrispondente (E0038)
    override int unknownMethod():
        return 0

// 3. STATIC VS INSTANCE (E0027, E0010, W0008)
class MathHelper:
    public:
    static int add(int a, int b):
        return a + b

    int multiply(int a, int b):
        return a * b

    static int invalidThis():
        return this.multiply(1, 2)  // 'this' in metodo statico (E0027)

// Chiamata statica valida
int res = MathHelper.add(10, 20)

// Chiamata non-statica da nome classe (E0010)
int badCall = MathHelper.multiply(2, 3)

// Chiamata statica da istanza (W0008)
MathHelper helper = MathHelper()
int warnCall = helper.add(5, 5)